# Copy to .env (same folder as pom.xml) and fill in. .env is git-ignored.
DB_URL=jdbc:postgresql://localhost:5432/riverwatch
DB_USER=riverwatch
DB_PASSWORD=change-me
# Used by docker-compose.yml to create the database container
POSTGRES_DB=riverwatch
POSTGRES_USER=riverwatch
POSTGRES_PASSWORD=change-me
# At least 32 characters of random text, e.g. output of: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# First administrator, created on startup if the email does not exist yet
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis123
# Set true when served over HTTPS
COOKIE_SECURE=false
# --- Increment 2: password reset email (SMTP). Leave MAIL_HOST empty to only log the link (development).
# Gmail example: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com,
# MAIL_PASSWORD=<16-character Google "App password">, MAIL_FROM=you@gmail.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Address of the React app, used to build the reset link
APP_BASE_URL=http://localhost:5173
